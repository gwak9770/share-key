+int sk_get_key_view(uint32_t kid, sk_key_view_t *view) {
+    const sk_key_t *k = find(kid);
+    if (!k || !view) return 0;
+    view->remaining = use_cnt ? (int)k->remaining : -1;
+    memcpy(view->blocked_reason, k->state == ST_REVOKED ? "03" :
+           k->state == ST_RETURNED ? "09" : "00", 3u);
+    return 1;
